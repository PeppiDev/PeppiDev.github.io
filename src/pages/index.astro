---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans-condensed/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { friends } from '../data/friends';

const email = 'ulloa.benjaminleonardo@gmail.com';
const github = 'https://github.com/PeppiDev';
const repo = 'https://github.com/PeppiDev/Sound3ds';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Benjamín Ulloa</title>
    <meta
      name="description"
      content="Benjamín Ulloa (Peppi) — programador de Chillán. Cada pieza tiene una razón de estar ahí."
    />
    <meta name="theme-color" content="#0d1b2a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Idioma: ?lang, luego lo que eligió el visitante, luego los idiomas del navegador en su orden -->
    <script is:inline>
      (function () {
        var l;
        try {
          l = new URLSearchParams(location.search).get('lang') || localStorage.getItem('lang');
        } catch (e) {}
        if (l !== 'es' && l !== 'en') {
          l = 'en';
          var all = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
          for (var i = 0; i < all.length; i++) {
            var c = String(all[i]).slice(0, 2).toLowerCase();
            if (c === 'es' || c === 'en') {
              l = c;
              break;
            }
          }
        }
        document.documentElement.lang = l;
      })();
    </script>
    <style is:inline>
      html:not([data-ready]) #ui {
        visibility: hidden;
      }
    </style>
    <noscript><style is:inline>html #ui { visibility: visible !important; }</style></noscript>
  </head>
  <body>
    <canvas id="world" aria-hidden="true"></canvas>

    <div id="ui" data-at="exterior" data-snd>
      <header class="bar">
        <a class="brand" href="#/">B. Ulloa</a>
        <nav aria-label="Lugares">
          <a href="#/">Exterior</a>
          <a href="#/taller">Sobre mí</a>
          <a href="#/lz20">Proyectos</a>
          <a href="#/contacto">Contacto</a>
        </nav>
        <button id="snd" type="button" aria-pressed="true">Sonido · sí</button>
        <button id="lng" type="button">EN</button>
      </header>

      <main>
        <!-- Exterior del hangar -->
        <section data-scene="exterior">
          <div class="title">
            <h1 tabindex="-1">Benjamín<br />Ulloa</h1>
            <p class="tagline">Cada pieza tiene una razón de estar ahí.</p>
            <p class="mono dim" id="live">Chillán</p>
          </div>
          <p class="hint mono">Elige un lugar para entrar</p>

          <a class="spot" data-to="lz20" href="#/lz20">
            <span class="tag"><b>LZ 20</b> Proyectos · Sound3ds</span>
          </a>
          <a class="spot" data-to="taller" href="#/taller">
            <span class="tag"><b>Hangar</b> Sobre mí</span>
          </a>
          <a class="spot" data-to="contacto" href="#/contacto">
            <span class="tag"><b>Radio</b> Contacto</span>
          </a>
        </section>

        <!-- Taller -->
        <section data-scene="taller" hidden>
          <a class="back mono floating" href="#/">← Salir del hangar</a>
          <button class="spot lampbtn right" type="button" data-lamp aria-pressed="false">
            <span class="tag"><b>Lámpara</b> <span data-lamp-label>encender</span></span>
          </button>
          <button class="hot" id="keys" type="button" aria-label="Teclado de la máquina de escribir: presiona las teclas"></button>
          <div class="papers">
            <article class="sheet" id="sheet1">
              <p class="mono kicker">Hangar · taller</p>
              <h2 tabindex="-1">Sobre mí</h2>
              <p class="mono role">Programador · estudiante de ciberseguridad · Chillán</p>
              <p>
                Antes de tocar una sola línea de código, ya pasaba tardes enteras frente a un Olidata con Windows XP —
                el computador de escritorio viejo de la casa, el mismo que cuidaba mientras mi hermano estudiaba
                informática y me cuidaba a mí. No elegí la programación tanto como ella me fue encontrando ahí, de a
                poco.
              </p>
              <p>Por un tiempo pensé que mi camino sería otro: la Fuerza Aérea. Pero aquí estoy.</p>
              <p>
                Ese amor por volar no desapareció, solo cambió de forma. Nació viendo Flyboys, una película de 2006 —
                el mismo año en que nací — y se quedó ahí, convertido con los años en una fascinación genuina por la
                ingeniería detrás de las aeronaves de época. Los zepelines, sobre todo: no por nostalgia de niño, sino
                por el mismo tipo de atención que le pongo a un reloj mecánico, un medidor analógico, una estación de
                radio — cosas donde cada pieza tiene una razón de estar ahí.
              </p>
              <p class="mono pageno">— 1 —</p>
            </article>
            <article class="sheet" id="sheet2" aria-label="Sobre mí, segunda hoja">
              <p class="mono pageno">— 2 —</p>
              <p data-type>
                Soy de Chillán. Salí de un liceo técnico con un título de programador, y hoy sigo estudiando — esta vez
                ciberseguridad. Entre medio, vuelvo seguido a la misma saga desde hace años: Metro. Quizás porque es lo
                más parecido, en forma de videojuego, a lo que me gusta de verdad: mecanismos e instrumentos, cosas que
                uno entiende mejor mientras más las mira.
              </p>
            </article>
          </div>
        </section>

        <!-- Cabina del LZ 20 -->
        <section data-scene="lz20" hidden>
          <a class="back mono floating" href="#/">← Desembarcar</a>
          <button class="back mono floating" id="look" type="button" aria-pressed="false">Mirar a estribor →</button>
          <button class="hot" id="pilot" type="button" aria-label="El timonel: dale un golpecito"></button>
          <p class="mono say" id="say" role="status"></p>
          <div id="dials" aria-label="Instrumentos: datos del proyecto y condiciones en Chillán"></div>
          <article id="log" class="log">
            <header>
              <p class="mono">Bitácora · LZ 20</p>
              <h2 tabindex="-1">Sound3ds</h2>
            </header>
            <p data-type>
              Un reproductor y cliente de streaming de música para Nintendo 3DS/2DS, escrito en C puro sobre devkitPro —
              el tipo de entorno donde no hay memoria de sobra ni margen para improvisar. Decodifica MP3, AAC y FLAC
              (hasta 24-bit/96kHz en la 3DS original), y se conecta a SoundCloud, Bandcamp y servidores de música
              propios como Navidrome o Subsonic.
            </p>
            <p data-type>
              Reproducción sin cortes con crossfade, cover flow, siete temas visuales con su propio visualizador de
              espectro, y una app complementaria para PC que transfiere música de forma inalámbrica por QR. Cada función
              se probó en hardware real — una 2DS vieja, una New 3DS XL, una New 2DS XL — porque en consolas de este
              tipo, lo que funciona en teoría no siempre funciona en la máquina de verdad.
            </p>
            <p class="mono stack">C · devkitPro · libctru · citro2d · libcurl · mbedTLS · MIT</p>
            <p><a class="mono" href={repo} rel="noopener">github.com/PeppiDev/Sound3ds →</a></p>
          </article>
        </section>

        <!-- Radio -->
        <section data-scene="contacto" hidden>
          <a class="back mono floating" href="#/">← Salir de la caseta</a>
          <div class="stage">
            <button class="spot lampbtn" type="button" data-lamp aria-pressed="false">
              <span class="tag"><b>Lámpara</b> <span data-lamp-label>encender</span></span>
            </button>
            <button class="spot lampbtn" id="framebtn" type="button">
              <span class="tag"><b>Amigos</b> ver la foto</span>
            </button>
            <button class="hot" id="tkey" type="button" aria-label="Manipulador telegráfico: mantén presionado para transmitir"></button>
          </div>
          <div class="friends">
            <button class="back mono floating" id="unzoom" type="button">← Volver a la mesa</button>
            {
              friends.map((f, i) => (
                <a class="spot friend" href={f.url} data-i={i} rel="noopener">
                  <span class="tag">
                    <b>{f.name}</b> {new URL(f.url).host} →
                  </span>
                </a>
              ))
            }
            <p class="mono soundnote">Activa el sonido (arriba) para oír la radio</p>
            <p class="mono onair" id="onair" role="status"></p>
          </div>
          <div class="papers">
            <article class="sheet" id="card">
              <p class="mono kicker">Estación de radio</p>
              <h2 tabindex="-1">Contacto</h2>
              <p>Dos canales, siempre abiertos.</p>
              <ul class="channels">
                <li>
                  <span class="mono">Correo</span>
                  <a href={`mailto:${email}`}>{email}</a>
                </li>
                <li>
                  <span class="mono">GitHub</span>
                  <a href={github} rel="noopener">github.com/PeppiDev</a>
                </li>
              </ul>
            </article>
          </div>
        </section>

        <!-- El búnker: sólo se llega escribiendo "true me" en la máquina -->
        <section data-scene="bunker" hidden>
          <button class="back mono floating" id="upstairs" type="button">← Volver arriba</button>
          <button class="hot" id="me" type="button" aria-label="Benjamín, echado en el sillón: háblale"></button>
          <p class="mono say" id="say2" role="status"></p>
          <span class="mono plate" id="rocky">Rocky</span>
        </section>
      </main>
    </div>

    <div id="flash" aria-hidden="true"></div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --line: #f2ede1;
    --amber: #f2a65a;
    --ink: 13 27 42;
    --sky: 13 27 42;
    --sans: 'IBM Plex Sans', system-ui, sans-serif;
    --cond: 'IBM Plex Sans Condensed', 'IBM Plex Sans', sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: rgb(var(--ink));
    color: var(--line);
    font: 400 1rem/1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  #world {
    position: fixed;
    inset: 0 auto auto 0;
    image-rendering: pixelated;
  }
  #ui {
    position: fixed;
    inset: 0;
    transition: opacity 0.25s;
  }
  #ui.moving main {
    opacity: 0;
    pointer-events: none;
  }
  main {
    transition: opacity 0.3s;
  }
  [hidden] {
    display: none !important;
  }
  a {
    color: var(--amber);
    text-underline-offset: 0.2em;
  }
  :focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 3px;
  }
  h1:focus,
  h2:focus {
    outline: none;
  }
  .mono {
    font: 500 0.72rem/1.5 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .dim {
    opacity: 0.78;
  }
  p {
    margin: 0 0 1em;
  }

  /* ── Barra ── */
  .bar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.35rem clamp(1rem, 4vw, 3rem);
    background: rgb(var(--ink) / 0.9);
    border-bottom: 1px solid rgb(242 237 225 / 0.3);
    font: 500 0.72rem/1 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .bar a,
  .bar button {
    color: var(--line);
    text-decoration: none;
    padding: 0.5rem 0;
  }
  .bar nav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }
  .bar a:hover,
  .bar a[aria-current] {
    color: var(--amber);
  }
  .bar a[aria-current] {
    box-shadow: 0 1px 0 var(--amber);
  }
  #snd,
  #lng {
    all: unset;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    padding: 0.5rem 0;
  }
  #lng {
    padding: 0.3rem 0.5rem;
    margin-left: -0.6rem;
    border: 1px solid rgb(242 237 225 / 0.45);
  }
  #lng:hover,
  #snd:focus-visible,
  #lng:focus-visible {
    color: var(--amber);
    border-color: var(--amber);
  }
  #snd[aria-pressed='true'] {
    color: var(--amber);
  }
  #ui[data-at='exterior'] .brand {
    visibility: hidden;
  }

  /* ── Exterior ── */
  .title {
    position: absolute;
    left: clamp(1rem, 4vw, 3rem);
    top: clamp(4rem, 11vh, 7rem);
    pointer-events: none;
  }
  .title p,
  .hint {
    width: fit-content;
    padding: 0.2rem 0.55rem;
    background: rgb(var(--ink) / 0.86);
  }
  .title h1 {
    text-shadow: 3px 3px 0 rgb(var(--ink));
  }
  h1 {
    margin: 0 0 0.6rem;
    font: 700 clamp(2.8rem, 7.2vw, 6.2rem) / 0.9 var(--cond);
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }
  .tagline {
    margin: 0 0 0.35rem;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }
  .hint {
    position: absolute;
    left: clamp(1rem, 4vw, 3rem);
    bottom: 1.4rem;
    margin: 0;
  }
  .hint::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.6rem;
    background: var(--amber);
    animation: blink 1.6s steps(2) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
  .spot {
    position: absolute;
    text-decoration: none;
    color: var(--line);
    /* marcas de registro en las esquinas, como en un plano */
    --m: 10px;
    background:
      linear-gradient(currentColor, currentColor) 0 0 / var(--m) 1px,
      linear-gradient(currentColor, currentColor) 0 0 / 1px var(--m),
      linear-gradient(currentColor, currentColor) 100% 0 / var(--m) 1px,
      linear-gradient(currentColor, currentColor) 100% 0 / 1px var(--m),
      linear-gradient(currentColor, currentColor) 0 100% / var(--m) 1px,
      linear-gradient(currentColor, currentColor) 0 100% / 1px var(--m),
      linear-gradient(currentColor, currentColor) 100% 100% / var(--m) 1px,
      linear-gradient(currentColor, currentColor) 100% 100% / 1px var(--m);
    background-repeat: no-repeat;
    transition: color 0.15s;
  }
  .spot:hover,
  .spot:focus-visible {
    color: var(--amber);
    --m: 18px;
    outline: none;
  }
  .tag {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.45rem);
    white-space: nowrap;
    font: 500 0.7rem/1.4 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    background: rgb(var(--ink) / 0.82);
  }
  .tag b {
    color: var(--amber);
    margin-right: 0.5em;
  }
  .spot[data-to='lz20'] .tag,
  .spot[data-to='taller'] .tag {
    left: auto;
    right: 0;
  }
  .spot[data-to='contacto'] .tag {
    left: 62%;
    bottom: auto;
    top: 46%;
  }

  /* ── Hojas de papel sobre el escritorio (taller, radio) ── */
  .papers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sheet {
    position: absolute;
    pointer-events: auto;
    overflow-y: auto;
    padding: 1.3rem 1.7rem 1rem;
    color: #17202b;
    background: var(--line);
    font: 400 clamp(0.68rem, 0.9vw, 0.86rem) / 1.62 var(--mono);
    filter: brightness(var(--lit, 1));
    scrollbar-width: thin;
    scrollbar-color: #9a4a2a transparent;
  }
  .sheet p {
    margin-bottom: 0.8em;
  }
  .sheet a {
    color: #17202b;
    font-weight: 500;
  }
  .sheet .kicker,
  .sheet .role {
    color: #9a4a2a;
    margin: 0;
  }
  .sheet .role {
    margin-bottom: 1.1em;
  }
  .sheet .pageno {
    text-align: center;
    margin: 0;
    opacity: 0.7;
  }
  .sheet h2,
  .log h2 {
    margin: 0 0 0.3rem;
    font: 700 clamp(1.8rem, 3.2vw, 3rem) / 1 var(--cond);
    text-transform: uppercase;
  }
  /* la hoja ya escrita descansa sobre el tablero, fugando con él */
  #sheet1,
  #card {
    transform-origin: 50% 100%;
    box-shadow: -7px 9px 0 rgb(var(--ink) / 0.65);
  }
  #sheet1 {
    transform: perspective(1500px) rotateX(15deg) rotateZ(-1.3deg);
  }
  #card {
    transform: perspective(1500px) rotateX(15deg) rotateZ(1.6deg);
    padding-top: 1.6rem;
  }
  /* la segunda sigue en la máquina: el texto termina a la altura del rodillo */
  #sheet2 {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1.2rem 0.7rem;
    /* sale del rodillo echada hacia atrás, con la punta vencida */
    transform-origin: 50% 100%;
    transform: translateX(var(--car, 0px)) perspective(700px) rotateX(13deg) rotateZ(0.7deg);
    background: linear-gradient(#b9b3a6 0, #dcd6c9 7%, var(--line) 20%);
    border-radius: 3px 5px 0 0;
    box-shadow: 6px 4px 0 rgb(var(--ink) / 0.45);
  }
  /* zonas presionables sin marco: teclado y manipulador */
  .hot {
    position: absolute;
    appearance: none;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* ── Caseta: cámara sobre la mesa, cuadro de amigos ── */
  .stage,
  .friends {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform-origin: 0 0;
  }
  .stage > *,
  .friends > * {
    pointer-events: auto;
  }
  [data-scene='contacto'] .papers {
    transform-origin: 0 0;
  }
  .friends > * {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s;
  }
  [data-zoom='frame'] .friends > :not(.onair),
  [data-zoom='tuning'] .onair {
    opacity: 1;
    visibility: visible;
  }
  [data-zoom]:not([data-zoom='']) > .back.floating,
  [data-zoom]:not([data-zoom='']) .stage {
    visibility: hidden;
  }
  .friend .tag {
    left: 50%;
    bottom: auto;
    top: calc(100% + 0.5rem);
    transform: translateX(-50%);
    font-size: 0.78rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid currentColor;
  }
  .onair {
    position: absolute;
    left: 50%;
    bottom: 12vh;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.5rem 1rem;
    white-space: nowrap;
    font-size: 0.86rem;
    color: var(--amber);
    background: rgb(var(--ink) / 0.9);
    border: 1px solid var(--amber);
  }
  .soundnote {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.2rem 0.55rem;
    white-space: nowrap;
    background: rgb(var(--ink) / 0.86);
  }
  #ui[data-snd] .soundnote {
    display: none;
  }
  .onair::before {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.7rem;
    border-radius: 50%;
    background: var(--amber);
    animation: blink 0.5s steps(2) infinite;
  }
  #sheet2 [data-type] {
    margin: auto 0 0;
  }
  .sheet .pending {
    visibility: hidden;
  }
  /* en la máquina el papel sube línea a línea: lo pendiente no ocupa lugar */
  #sheet2 .pending {
    display: none;
  }
  .lampbtn {
    appearance: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    --m: 7px;
  }
  .lampbtn .tag {
    opacity: 0;
    transition: opacity 0.15s;
  }
  .lampbtn.right .tag {
    left: auto;
    right: 0;
  }
  .lampbtn:hover .tag,
  .lampbtn:focus-visible .tag {
    opacity: 1;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.3rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid currentColor;
    text-decoration: none;
  }
  .back:hover {
    background: var(--amber);
    color: rgb(var(--ink));
    border-color: var(--amber);
  }
  button.back {
    color: var(--line);
    cursor: pointer;
  }
  .back.floating {
    position: absolute;
    z-index: 4;
    left: clamp(1rem, 4vw, 3rem);
    top: 4.2rem;
    background: rgb(var(--ink) / 0.85);
  }
  .back.floating:hover {
    background: var(--amber);
  }
  #look {
    left: auto;
    right: clamp(1rem, 4vw, 3rem);
  }
  [data-scene='lz20'] > :not(.back) {
    translate: var(--turn, 0px);
  }
  [data-look] > :not(.back) {
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s 0.95s;
  }
  .channels {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .channels li {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 0;
    border-top: 1px solid rgb(23 32 43 / 0.3);
  }
  .channels .mono {
    color: #9a4a2a;
  }
  .channels a {
    font-size: 1.12em;
    overflow-wrap: anywhere;
  }

  /* fogonazo del disparo */
  #flash {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: var(--line);
    opacity: 0;
    pointer-events: none;
  }
  #flash.on {
    animation: flash 1.1s ease-out;
  }
  @keyframes flash {
    0%,
    12% {
      opacity: 1;
      background: var(--amber);
    }
    25% {
      background: var(--line);
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* ── Cabina ── */
  /* lo que contesta el timonel cuando lo molestan */
